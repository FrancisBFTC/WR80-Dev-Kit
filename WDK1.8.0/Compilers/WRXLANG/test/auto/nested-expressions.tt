Message {
	Name    = "Nested Expressions Tests for WRX Compiler"
	Success = "Test OK!"
	Error   = "Test Fail!"
	Setup   = "wrx -q -a FULL -c"
}

test nested_logic_byte_word_comparisons{

	Input =	" byte A = 10;" &
					" word B = 0x0100;" &
					" byte C = 1;" &
					"" &
					" if((A == 10) && (B != 0) && (C == 1)){" &
					"     1;" &
					" }else{" &
					"     2;" &
					" }"

	Output =	" JP __main" &
					"" &
					"A:" &
					" DB 10" &
					"B:" &
					" DW 256" &
					"C:" &
					" DB 1" &
					"" &
					"__main:" &
					" PUSHB" &
					" PUSHS" &
					" POPB" &
					"" &
					" PUSH R0" &
					" STD 0x01" &
					" LD R0" &
					" STD C::8" &
					" OUT P0" &
					" STD C::0" &
					" OUT P1" &
					" IN P2" &
					" BT R0" &
					" JZ @+5" &
					" CDR" &
					" JP @+4" &
					" STD 1" &
					" JZ @+4" &
					" STD 1" &
					" LD R0" &
					" STD 0x00" &
					" PUSHD" &
					" STD 0x00" &
					" LD R1" &
					" STD B::8" &
					" OUT P0" &
					" STD B::0" &
					" OUT P1" &
					" STD 0x01" &
					" IDC" &
					" INCR" &
					" IN P2" &
					" PUSHD" &
					" DECR" &
					" IN P2" &
					" BT R1" &
					" JZ @+6" &
					" STD 1" &
					" JP @+3" &
					" CDR" &
					" JZ @+4" &
					" JP @+14" &
					" POPD" &
					" POP R2" &
					" PUSH R2" &
					" PUSH R2" &
					" BT R2" &
					" JZ @+6" &
					" STD 1" &
					" JP @+3" &
					" CDR" &
					" POP R2" &
					" POP R2" &
					" JZ @+4" &
					" STD 1" &
					" LD R1" &
					" STD 0x0A" &
					" LD R2" &
					" STD A::8" &
					" OUT P0" &
					" STD A::0" &
					" OUT P1" &
					" IN P2" &
					" BT R2" &
					" JZ @+5" &
					" CDR" &
					" JP @+4" &
					" STD 1" &
					" JZ @+4" &
					" STD 1" &
					" AND R1" &
					" JZ @+4" &
					" STD 1" &
					" AND R0" &
					" JZ else_0" &
					" STD 0x01" &
					" JP endif_1" &
					"else_0:" &
					" STD 0x02" &
					"endif_1:" &
					" JP __end" &
					"" &
					"__end:" &
					"" &
					""
}


test nested_logic_word_assignment{

	Input =	" word A = 1;" &
					" word B = 0x0100;" &
					" word X = (A == 1) && (B == 0x0100);" &
					"" &
					" if(X == 1){" &
					"     1;" &
					" }else{" &
					"     2;" &
					" }"

	Output =	" JP __main" &
