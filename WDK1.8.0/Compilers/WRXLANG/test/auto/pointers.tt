Message {
	Name    = "Pointer Tests for WRX Compiler"
	Success = "Test OK!"
	Error   = "Test Fail!"
	Setup   = "wrx -q -a FULL -c"
}

test pointer-read-byte {
	Input = "byte A = 65;" &
			"word P = &A;" &
			"byte X = *P;" &
			"" &
			"if(X == 65){" &
			"	1;" &
			"}else{" &
			"	2;" &
			"}"
	Output = " JP __main" &
			"" &
			"A:" &
			" DB 65" &
			"P:" &
			" DW 0" &
			"X:" &
			" DB 0" &
			"" &
			"__main:" &
			" PUSHB" &
			" PUSHS" &
			" POPB" &
			"" &
			" PUSH R0" &
			" STD A::8" &
			" PUSHD" &
			" STD A::0" &
			" PUSHD" &
			" STD P::8" &
			" OUT P0" &
			" STD P::0" &
			" OUT P1" &
			" STD 0x01" &
			" IDC" &
			" POPD" &
			" OUT P2" &
			" INCR" &
			" POPD" &
			" OUT P2" &
			" STD P::8" &
			" OUT P0" &
			" STD P::0" &
			" OUT P1" &
			" STD 0x01" &
			" IDC" &
			" INCR" &
			" IN P2" &
			" PUSHD" &
			" DECR" &
			" IN P2" &
			" OUT P1" &
			" POPD" &
			" OUT P0" &
			" IN P2" &
			" PUSHD" &
			" STD X::8" &
			" OUT P0" &
			" STD X::0" &
			" OUT P1" &
			" POPD" &
			" OUT P2" &
			" STD 0x41" &
			" LD R0" &
			" STD X::8" &
			" OUT P0" &
			" STD X::0" &
			" OUT P1" &
			" IN P2" &
			" BT R0" &
			" JZ @+5" &
			" CDR" &
			" JP @+4" &
			" STD 1" &
			" JZ else_0" &
			" STD 0x01" &
			" JP endif_1" &
			"else_0:" &
			" STD 0x02" &
			"endif_1:" &
			" JP __end" &
			"" &
			"__end:" &
			"" &
			""
}

