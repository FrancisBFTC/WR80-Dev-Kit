test pointer-arithmetic-byte-in-word-pointer {
	Input = "word A = 0x1234;" &
			"word P = &A;" &
			"" &
			"*P = *P * 0x0002;" &
			"*(P+1) = *(P+1) * 0x0002;" &
			"" &
			"if(*P == 0x2468){" &
			"	1;" &
			"}else{" &
			"	2;" &
			"}"
	Output = " JP __main" &
			"" &
			"A:" &
			" DW 4660" &
			"P:" &
			" DW 0" &
			"" &
			"__main:" &
			" PUSHB" &
