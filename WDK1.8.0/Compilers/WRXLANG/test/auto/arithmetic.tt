Message {
	Name    = "Addition Operation for WRX Compiler"
	Success = "Test OK!"
	Error   = "Test Fail!"
	Setup   = "wrx -q -a FULL -c"
}

test add-word-in-if {
	Input = "word A = 0xFFFF;" &
			"word B = 0xFFFF;" &
			"" &
			"if(A + B){" &
			"	1;" &
			"}else{" &
			"	2;" &
			"}"
	Output = " JP __main" &
			"" &
			"A:" &
			" DW 65535" &
			"B:" &
			" DW 65535" &
			"" &
			"__main:" &
			" PUSHB" &
			" PUSHS" &
			" POPB" &
			"" &
			" PUSH R0" &
			" STD B::8" &
			" OUT P0" &
			" STD B::0" &
			" OUT P1" &
			" STD 0x01" &
			" IDC" &
			" INCR" &
			" IN P2" &
			" PUSHD" &
			" DECR" &
			" IN P2" &
			" LD R0" &
			" STD A::8" &
			" OUT P0" &
			" STD A::0" &
			" OUT P1" &
			" STD 0x01" &
			" IDC" &
			" INCR" &
			" IN P2" &
			" PUSHD" &
			" DECR" &
			" IN P2" &
			" ADD R0" &
			" JC @+10" &
			" LD R0" &
			" POPD" &
			" POP R1" &
			" ADD R1" &
			" PUSHD" &
			" STL R0" &
			" JP @+12" &
			" LD R0" &
			" STD 0x80" &
			" IDC" &
			" POPD" &
			" INCR" &
			" POP R1" &
			" ADD R1" &
			" PUSHD" &
			" STL R0" &
			" POP R1" &
			" OR R1" &
			" JZ else_0" &
			" STD 0x01" &
			" JP endif_1" &
			"else_0:" &
			" STD 0x02" &
			"endif_1:" &
			" JP __end" &
			"" &
			"__end:" &
			"" &
			""
}

test add-word-in-byte-var {
