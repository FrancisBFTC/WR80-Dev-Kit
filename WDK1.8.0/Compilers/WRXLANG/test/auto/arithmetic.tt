			" PUSHD" &
			" DECR" &
			" IN P2" &
			" ADD R0" &
			" JC @+10" &
			" LD R0" &
			" POPD" &
			" POP R1" &
			" ADD R1" &
			" PUSHD" &
			" STL R0" &
			" JP @+12" &
			" LD R0" &
			" STD 0x80" &
			" IDC" &
			" POPD" &
			" INCR" &
