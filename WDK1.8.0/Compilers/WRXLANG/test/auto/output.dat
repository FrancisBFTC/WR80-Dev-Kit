 JP __main

W:
 DB 0

__main:
 PUSHB
 PUSHS
 POPB

 PUSH R0
 STD 0x01
 JZ endif_0
 STD 2
 SSP
 STD 0xFF
 PUSHD
 STD 0xFF
 LD R2
 STD 3
 SBW
 POPD
 LD R2
 STD 2
 SBW
 STD 2
 SBP
 PUSHD
 STD 3
 SBP
 LD R0
 NOT R0
 LD R0
 POP R1
 NOT R1
 PUSHD
 STL R0
 POP R1
 OR R1
 JZ @+5
 CDR
 JP @+4
 STD 1
 LD R0
 JZ else_1
 STD 0x01
 JP endif_2
else_1:
 STD 0x02
endif_2:
 STD -2
 SSP
endif_0:
 JP __end

__end:

