test local-pointer-greater-or-equal {
	Input = "byte A = 21;" &
			"byte B = 20;" &
			"if(1){" &
			"	word P = &A;" &
			"	word Q = &B;" &
			"" &
			"	if(!(*P < *Q)){" &
			"		1;" &
			"	}else{" &
			"		2;" &
			"	}" &
