Message {
	Name    = "Equality Operation for WRX Compiler"
	Success = "Test OK!"
	Error   = "Test Fail!"
	Setup   = "wrx -q -a FULL -c"
}

test local-equal-in-if {
	Input = "byte W;" &
			"if(1){" &
			"	word A = 0xFFFF;" &
			"	word B = 0xFFFF;" &
			"" &
			"	if(A == B){" &
			"		1;" &
			"	}else{" &
			"		2;" &
			"	}" &
			"}"
	Output = " JP __main" &
			"" &
			"W:" &
			" DB 0" &
			"" &
			"__main:" &
			" PUSHB" &
			" PUSHS" &
			" POPB" &
			"" &
			" PUSH R0" &
			" STD 0x01" &
			" JZ endif_0" &
			" STD 2" &
			" SSP" &
			" STD 0xFF" &
			" PUSHD" &
			" STD 0xFF" &
			" LD R2" &
			" STD 3" &
			" SBW" &
			" POPD" &
			" LD R2" &
			" STD 2" &
			" SBW" &
			" STD 2" &
			" SSP" &
			" STD 0xFF" &
			" PUSHD" &
			" STD 0xFF" &
			" LD R2" &
			" STD 5" &
			" SBW" &
			" POPD" &
			" LD R2" &
			" STD 4" &
			" SBW" &
			" STD 4" &
			" SBP" &
			" PUSHD" &
			" STD 5" &
			" SBP" &
			" LD R0" &
			" STD 2" &
			" SBP" &
			" PUSHD" &
			" STD 3" &
			" SBP" &
			" BT R0" &
			" JZ @+5" &
			" CDR" &
			" JP @+4" &
			" STD 1" &
			" JZ @+14" &
			" POPD" &
			" POP R1" &
			" PUSH R1" &
			" PUSH R1" &
			" BT R1" &
			" JZ @+5" &
			" CDR" &
			" JP @+4" &
			" STD 1" &
			" POP R1" &
			" POP R1" &
			" JZ else_1" &
			" STD 0x01" &
			" JP endif_2" &
			"else_1:" &
			" STD 0x02" &
			"endif_2:" &
			" STD -4" &
			" SSP" &
			"endif_0:" &
			" JP __end" &
			"" &
			"__end:" &
			"" &
			""
}

