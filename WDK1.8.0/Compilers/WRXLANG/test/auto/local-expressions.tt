test local-less-in-if {
	Input = "byte W;" &
			"if(1){" &
			"	word A = 0x8050;" &
			"	word B = 0x5060;" &
			"" &
			"	if(A < B){" &
			"		1;" &
			"	}else{" &
			"		2;" &
